# Ejemplo de variables de entorno para un FUTURO backend (Flask, API, etc.).
# Copia este archivo como .env y llena los valores SOLO en tu computadora o servidor.
# .env está en .gitignore: nunca se sube a GitHub.
#
# El sitio actual es 100% estático (GitHub Pages) y NO usa este archivo.
# Los datos públicos (WhatsApp, redes, horarios) van en docs/assets/js/config.js.

# FLASK_SECRET_KEY=
# DATABASE_URL=
# WHATSAPP_CLOUD_API_TOKEN=
# PAYMENT_PROVIDER_SECRET_KEY=
# ADMIN_EMAIL=
